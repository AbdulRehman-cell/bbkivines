# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in the values for local development.
# ==============================================================================

# Application execution context (development, staging, production)
NODE_ENV=development

# Server listening port
PORT=10000

# Connection string for MongoDB (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/bbkivines

# JSON Web Token Secret (Use a strong cryptographically generated string in production)
JWT_SECRET=use_a_cryptographically_secure_random_string_of_at_least_32_characters

# Client origin permitted to execute CORS requests
CORS_ORIGIN=http://localhost:3000